{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-stage.mjs && next dev",
    "build": "node scripts/build-stage.mjs && next build --turbopack && node scripts/strip-hydration.mjs",
    "preview": "node scripts/preview.mjs",
    "og": "node scripts/generate-og.mjs",
    "shots": "node scripts/process-shots.mjs",
    "demos:record": "node --env-file-if-exists=.env.local scripts/record-demos.mjs",
    "demos:process": "node scripts/process-demos.mjs",
    "demos": "npm run demos:record && npm run demos:process",
    "stage": "node scripts/build-stage.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.169.0",
    "esbuild": "^0.24.2",
    "hyperframes": "^0.8.26",
    "playwright": "^1.62.1",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2"
  }
}
